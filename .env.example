# Optional overrides for docker compose (copy to .env and edit)
# PORT=2200
# MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# MAX_BATCH_SIZE=128
# MAX_NUM_PAGES=2048
# DETOKENIZE_INTERVAL=5
# HF_TOKEN=hf_xxx
# NVIDIA_VISIBLE_DEVICES=0
# Host Hugging Face cache used while BUILDING the image (speeds up build)
# HF_CACHE_HOST=/root/.cache/huggingface
# Official Qwen sampling (defaults in compose/entrypoint). Keep top_p=1.0.
# TEMPERATURE=0.9
# TOP_P=1.0
# TOP_K=50
# REPETITION_PENALTY=1.05
# MAX_TOKENS=512
